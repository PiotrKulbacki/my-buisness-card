# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://piotrkulbacki.com

# Optional — Meta / Facebook App ID (Sharing Debugger wants fb:app_id)
# Create at https://developers.facebook.com/apps/ → App settings → App ID
# NEXT_PUBLIC_FACEBOOK_APP_ID=

# Optional override for email <img> assets (defaults to NEXT_PUBLIC_SITE_URL)
# EMAIL_ASSET_BASE_URL=https://piotrkulbacki.com

# Brevo transactional email (optional in local — without keys the API logs and returns mocked success)
BREVO_API_KEY=
BREVO_FROM_EMAIL=Piotr Kulbacki <kontakt@piotrkulbacki.com>
CONTACT_TO_EMAIL=it.piotr.kulbacki@gmail.com

# Cloudflare Turnstile (same keys as on Vercel — needed for local form tests)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
